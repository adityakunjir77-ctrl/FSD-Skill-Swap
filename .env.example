# Server Configuration
PORT=5000
# Must be "production" in any deployed environment. "development" adds stack
# traces to error responses.
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/skillswap

# Authentication
# Required. The server will not start without a private random value of at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Local development only. Enables auto-seeding of demo accounts with public
# passwords and the embedded fallback database. Ignored when NODE_ENV=production.
ENABLE_DEMO_DATA=true

# Number of reverse proxies in front of the app, so rate limits see real client
# IPs. Leave at 0 unless deployed behind one.
TRUST_PROXY=0
