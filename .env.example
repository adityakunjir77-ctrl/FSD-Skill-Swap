# Server Configuration
PORT=5000
# Must be "production" in any deployed environment. "development" adds stack
# traces to error responses.
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
# MongoDB connection pool and timeouts (optional; defaults shown). Each server
# process opens up to MONGO_MAX_POOL_SIZE connections, so keep
# MONGO_MAX_POOL_SIZE x process count under the database connection limit.
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=0
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
# Indexes build automatically only when NODE_ENV is development or test. Elsewhere,
# run "npm run db:indexes" in server/ before each release.
# MONGO_AUTO_INDEX=false

# Authentication
# Required. The server will not start without a private random value of at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Local development only. Enables auto-seeding of demo accounts with public
# passwords and the embedded fallback database. Ignored unless NODE_ENV is
# development or test.
ENABLE_DEMO_DATA=true

# Number of reverse proxies in front of the app, so rate limits see real client
# IPs. Leave at 0 unless deployed behind one. Must be a whole number from 0 to
# 10; any other value stops the server at startup.
TRUST_PROXY=0
# Redis (optional). Required when running more than one server instance: it
# shares Socket.IO rooms (live chat, notifications, sign-out on suspension)
# and rate-limit counters between instances. Leave unset for a single
# instance. Example: redis://default:password@host:6379 (use rediss:// for TLS)
# REDIS_URL=
